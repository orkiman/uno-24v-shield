	(text "F1 + TVS5: a surge on the 24V line is clamped by TVS5 (SMBJ28A, VBR 31.1 V, VC 45.4 V)."
		(exclude_from_sim no)
		(at 20.32 125 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "fa097848-9cba-5067-9eae-2a73e996e77b")
	)
	(text "If 24V and GND are swapped, TVS5 conducts and F1 trips (resets after the fault is removed)."
		(exclude_from_sim no)
		(at 20.32 129 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7981121b-3866-5737-815d-6086506d2b1d")
	)
	(text "F1 carries only the board current and the flyback pulses, not the load current."
		(exclude_from_sim no)
		(at 20.32 133 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "4376306c-7a4f-5f8f-8810-de195940870c")
	)
	(text "J5 pins 2, 3, 4 are GND: the return current of all outputs (5 A max) is split over three terminals."
		(exclude_from_sim no)
		(at 20.32 137 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9b0468ba-3dad-5194-9014-e9f38a18bb33")
	)
	(text "D1 blocks reverse voltage to the regulator; 78M12 feeds the Arduino VIN pin (12 V)."
		(exclude_from_sim no)
		(at 20.32 141 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "70fdcf77-3e14-5dff-ba07-03bfc3b86705")
	)
